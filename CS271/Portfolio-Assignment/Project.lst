 000000BF  B9 000000F1			MOV		ECX, BUFFER_SIZE
 000000C4  E8 00000000 E		CALL	ReadFromFile


 000000C9  8B 75 14			MOV		ESI, [EBP+20]
 000000CC  8B 7D 08			MOV		EDI, [EBP+8]
 000000CF  B9 00000018			MOV		ECX, TEMPS_PER_DAY

 000000D4  FC				CLD
 000000D5			_NextInt:
 000000D5  C6 45 FF 00			MOV		negBool, 0
 000000D9  C7 45 F8			MOV		currTemp, 0
	   00000000
 000000E0  B8 00000000			MOV		EAX, 0
 000000E5			_IntLoop:
 000000E5  AC				LODSB
 000000E6  3C 2D			CMP		AL, 45
 000000E8  75 06			JNE		_NonNegative
 000000EA			_Negative:
