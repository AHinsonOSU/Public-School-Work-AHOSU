			      C 

				; (insert macro definitions here)
				mGetString MACRO strToPrint:REQ, strSaveAdd:REQ, count
					PUSH	EAX
					PUSH	ECX
					PUSH	EDX
					mDisplayString	OFFSET strToPrint
					MOV		EDX, strSaveAdd
					MOV		ECX, count
					CALL	ReadString
					CALL	CrLf
					POP		EDX
					POP		ECX
					POP		EAX
				ENDM

				mDisplayString MACRO strToDisplay:REQ
					PUSH	EDX
					MOV		EDX, strToDisplay
					CALL	WriteString
					POP		EDX
				ENDM

				mDisplayChar MACRO charA:REQ
					PUSH	EAX
					MOV		AL, charA
					CALL	WriteChar
					POP		EAX
				ENDM

