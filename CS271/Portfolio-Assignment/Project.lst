				;---------------------------------------------------------------------
				;Name: generateTemperatures
				;
				;takes an output array and fills it with random numbers in a range based on global constants
				;
				;Preconditions: defined output array and randomize called in main
				;
				;Postconditions: fills output array
				;
				;Recieves: output array
				;
				;Returns: filled output array
				;--------------------------------------------------------------------------------------------
 00000091			parseTempsFromString PROC
					LOCAL	negBool:BYTE, currTemp:SDWORD
					;EBP+20 is the file buffer
					;EBP+16 is the bool num for true/false of opening the file
					;EBP+12 is file name
					;EBP+8 is the output array
 00000091  55		   *	    push   ebp
 00000092  8B EC	   *	    mov    ebp, esp
 00000094  83 C4 F8	   *	    add    esp, 0FFFFFFF8h
 00000097  8B 55 0C			MOV		EDX, [EBP+12]
 0000009A  E8 00000000 E		CALL	OpenInputFile

 0000009F  83 F8 FF			CMP		EAX, INVALID_HANDLE_VALUE
 000000A2  8B 5D 10			MOV		EBX, [EBP+16]
 000000A5  50				PUSH	EAX
 000000A6  74 02			JE		_InputError
 000000A8  EB 0A			JMP		_Continue

 000000AA			_InputError:
 000000AA  B8 00000001			MOV		EAX, 1
 000000AF  89 03			MOV		[EBX], EAX
 000000B1  58				POP		EAX
