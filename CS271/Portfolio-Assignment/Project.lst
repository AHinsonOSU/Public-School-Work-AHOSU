				;----------------------------------------------------------------------------------------
				;Name: findDailyHighs
				;
				;This will intake an input array and output array both by reference and move the
				;highest value of each "row" of the input array to the output array
				;
				;Preconditions: input array filled, output array defined
				;
				;Postconditions: fills the output array
				;
				;Receives: input array and output array both by reference
				;
				;Returns: filled output array
				;--------------------------------------------------------------------------------------------
 0000012B			writeTempsReverse PROC
 0000012B  55				PUSH	EBP
 0000012C  8B EC			MOV		EBP, ESP
					;[EBP+8] = tempArray
 0000012E  8B 75 08			MOV		ESI, [EBP+8]
 00000131  83 C6 5C			ADD		ESI, ((TEMPS_PER_DAY * 4) - 4)
					;MOV		ECX, DAYS_MEASURED
 00000134  B9 00000018			MOV		ECX, TEMPS_PER_DAY

 00000139			_nextTemp:
 00000139  FD				STD
 0000013A  AD				LODSD
 0000013B  E8 00000000 E		CALL	WriteInt
 00000140  83 F9 01			CMP		ECX, 1
 00000143  74 12			JE		_lastTemp
					mDisplayChar DELIMITER
 00000145  50		     1		PUSH	EAX
 00000146  B0 2C	     1		MOV		AL, DELIMITER
 00000148  E8 00000000 E     1		CALL	WriteChar
 0000014D  58		     1		POP		EAX
					mDisplayChar SPACE
 0000014E  50		     1		PUSH	EAX
 0000014F  B0 20	     1		MOV		AL, SPACE
 00000151  E8 00000000 E     1		CALL	WriteChar
 00000156  58		     1		POP		EAX
 00000157			_lastTemp:
 00000157  E2 E0			LOOP	_nextTemp

 00000159  5D				POP		EBP
 0000015A  C2 0004			RET		4
 0000015D			writeTempsReverse	ENDP

